KEEPS_ROOT=/volume2/docker/keeps/data
KEEPS_CPUSET=2-3
KEEPS_MEMORY_LIMIT=2g
KEEPS_THUMBNAIL_QUALITY=50
# Enable after validating the new clients and NAS generation pipeline.
KEEPS_CACHE_GC_ENABLED=0
# Set to 0 while a remote worker handles encoding; NAS maintenance continues.
KEEPS_LOCAL_CACHE_ENCODING_ENABLED=1
ORIGINAL_ROOT=/volume2/photo
TZ=America/New_York
KEEPS_LIBRARY_ID=local-library
# Replace with the HTTPS hostname configured in DSM Reverse Proxy.
CONTROL_PLANE_PUBLIC_BASE_URL=https://keeps.hechuannas.synology.me

CONTROL_PLANE_AUTO_CREATE_SCHEMA=1

# Generate locally with: openssl rand -hex 32
KEEPS_ACCESS_TOKEN=
