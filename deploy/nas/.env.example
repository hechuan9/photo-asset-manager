KEEPS_ROOT=/volume2/myphoto/keeps
ORIGINAL_ROOT=/volume2/photo
RAW_UNPROCESSED_ROOT=/volume2/myphoto/未处理Raw
RAW_PROCESSED_ROOT=/volume2/myphoto/已处理Raw
PERSONAL_PHOTOS_ROOT=/volume2/myphoto/和川专属
TZ=America/New_York
